DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REDIS_URL=redis://localhost:6379/0
REDIS_TEST_URL=redis://localhost:6379/1
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_IP_RATE_LIMIT_MAX_ATTEMPTS=30
LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=60
CELERY_BROKER_URL=amqp://USERNAME:PASSWORD@HOST:5672/VHOST
CELERY_RESULT_BACKEND=disabled://
FLOWER_BASIC_AUTH=USERNAME:PASSWORD

DOCUMENT_UPLOAD_MAX_BYTES=1048576
DOCUMENT_PROCESSING_STALE_AFTER_SECONDS=600
DOCUMENT_MAINTENANCE_INTERVAL_SECONDS=60
OUTBOX_PUBLISH_BATCH_SIZE=100
OUTBOX_PUBLISH_INTERVAL_SECONDS=10

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Когда Python запускается на компьютере.
# Docker app/worker переопределят это на minio:9000.
MINIO_ENDPOINT=localhost:9000

# Адрес, который получит браузер в presigned URL.
MINIO_PUBLIC_ENDPOINT=localhost:9000

MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false
MINIO_DOCUMENTS_BUCKET=ai-support-documents-v1
MINIO_PRESIGNED_GET_EXPIRES_SECONDS=300
